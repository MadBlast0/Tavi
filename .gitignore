# Logs
logs
*.log
pnpm-debug.log*

# Secrets. `*.local` already covers .env.local, but a bare `.env` would
# otherwise be committed, and it is the file most likely to hold a provider key.
.env
.env.*
!.env.example
!.env.*.example

# TypeScript incremental build info
*.tsbuildinfo

node_modules
dist
dist-ssr
*.local

# The merge bot's local configuration — which session it wakes. It is
# about this machine, not about the project.
.tavi-merge.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
