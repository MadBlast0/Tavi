{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavi",
  "version": "0.1.0",
  "identifier": "com.mad.tavi",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tavi",
        "width": 1030,
        "height": 579,
        "minWidth": 600,
        "minHeight": 338,
        "center": true,
        "preventOverflow": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
