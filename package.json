    "@fontsource-variable/geist": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "ai": "^7.0.142",
