# Copy to .env.local and fill in what you need:  cp .env.example .env.local
#
# .env.local is gitignored, so this file is what a fresh clone has to go on.
# Everything here is optional - the app runs without it and tells you what is
# missing when you try to chat. The key can also be set in-app, from the key
# icon in the top-right bar, which is stored in the OS credential store rather
# than here.

# Provider key. Server-side only; never sent to the browser.
OPENROUTER_API_KEY=

# Chat server port. Must match the proxy target in vite.config.ts - both read
# this variable, so changing it in one place and not the other breaks the
# connection.
CHAT_SERVER_PORT=8787

# Overrides where projects are stored. Unset, the app uses its own default.
TAVI_PROJECTS_DIR=